private theorem checked : checkSpans 25 395 rows = true := by
  decide

theorem nine_six_three_finite (n : Nat) (hlo : 25 ≤ n) (hhi : n < 395) :
    ∃ cs, NineSixThree n cs :=
  spans_sound checked hlo hhi (by omega)

/-- Conjecture 1 of Lyman, Morris, and Toomey. -/
theorem nine_six_three_from_25 (n : Nat) (hn : 25 ≤ n) : ∃ cs, NineSixThree n cs := by
  by_cases h : n < 395
  · exact nine_six_three_finite n hn h
  · exact nine_six_three_from_395 n (by omega)

#print axioms nine_six_three_from_25

end DisjointCovers
