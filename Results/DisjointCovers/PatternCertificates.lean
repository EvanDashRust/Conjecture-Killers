import ThreePattern
import Checker

namespace DisjointCovers

/-- One row covers an entire interval of lengths ending at `last`. -/
private structure Span where
  last : Nat
  point : Nat
  classes : List Class

private def checkSpan (first : Nat) (s : Span) : Bool :=
  checkCover s.last s.classes &&
  s.classes.all (fun c => decide (c.2 + c.1 < first)) &&
  decide (s.point + 2 < first ∧ PatternAt s.classes s.point)

private theorem span_sound {first n : Nat} {s : Span} (h : checkSpan first s = true)
    (hlo : first ≤ n) (hhi : n ≤ s.last) (hn : 18 ≤ n) : ∃ cs, NineSixThree n cs := by
  simp only [checkSpan, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  have hc := cover_of_check h.1.1
  have hncover : Cover n s.classes := by
    refine ⟨hc.distinct, ?_, fun x hx => hc.partition x (by omega)⟩
    intro c hmem
    obtain ⟨hle, hlt, _⟩ := hc.valid c hmem
    have htwo := h.1.2 c hmem
    exact ⟨hle, hlt, by omega⟩
  exact ⟨s.classes.map shift, shift_pattern hn hncover (by have := h.2.1; omega) h.2.2⟩

private def checkSpans (first stop : Nat) : List Span → Bool
  | [] => decide (stop ≤ first)
  | row :: rest =>
    checkSpan first row && checkSpans (row.last+1) stop rest

private theorem spans_sound {first stop n : Nat} {rows : List Span}
    (h : checkSpans first stop rows = true) (hlo : first ≤ n) (hhi : n < stop)
    (hn : 18 ≤ n) : ∃ cs, NineSixThree n cs := by
  induction rows generalizing first with
  | nil =>
    simp [checkSpans] at h
    omega
  | cons row rest ih =>
    simp only [checkSpans, Bool.and_eq_true] at h
    by_cases hr : n ≤ row.last
    · exact span_sound h.1 hlo hr hn
    · exact ih h.2 (by omega)

