private theorem pairedChecked :
    checkTable checkPair 44 paired = true := by
  decide

theorem paired_base (n : Nat) (lo : 44 ≤ n) (hi : n < 132) :
    ∃ cs ds, Cover n cs ∧ Cover n ds ∧ Separate cs ds := by
  let i := n - 44
  have bound : i < paired.length := by
    change i < 88
    omega
  have fromTable := checkTable_at pairedChecked bound
  have hn : 44 + i = n := by omega
  rw [hn] at fromTable
  exact ⟨paired[i].1, paired[i].2, pair_of_check fromTable⟩


end DisjointCovers
